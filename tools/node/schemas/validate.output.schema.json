{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "title": "validate output",
  "required": [
    "ok",
    "data"
  ],
  "properties": {
    "ok": {
      "const": true
    },
    "data": {
      "type": "object",
      "properties": {
        "valid": {
          "type": "boolean"
        },
        "errors": {
          "type": "array"
        },
        "warnings": {
          "type": "array"
        }
      },
      "additionalProperties": true
    }
  }
}
