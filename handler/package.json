{
  "name": "treesite-handler",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "serve:artifact": "node ../tools/node/serve-artifact.js",
    "add:card": "node ../tools/node/add-card.js",
    "delete:card": "node ../tools/node/delete-card.js",
    "edit:card": "node ../tools/node/edit-card.js",
    "rename:card": "node ../tools/node/rename-card.js",
    "move:card": "node ../tools/node/move-card.js",
    "hide:card": "node ../tools/node/set-card-visibility.js --hidden true",
    "unhide:card": "node ../tools/node/set-card-visibility.js --hidden false",
    "add:pdf": "node ../tools/node/add-pdf.js",
    "add:website": "node ../tools/node/add-website.js",
    "add:html": "node ../tools/node/add-html.js",
    "rebuild:site-data": "node ../tools/node/rebuild-site-data.js",
    "migrate:scaffold": "node ../tools/node/migrate-scaffold-from-site-data.js",
    "inspect:tree": "node ../tools/node/inspect-tree.js",
    "inspect:card-index": "node ../tools/node/inspect-tree.js --card-index",
    "move:subtree": "node ../tools/node/move-subtree.js",
    "snapshot:websites": "node ../tools/node/snapshot-websites.js"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "marked": "^18.0.3",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sanitize-html": "^2.17.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "playwright": "^1.60.0",
    "vite": "^8.0.12"
  }
}
